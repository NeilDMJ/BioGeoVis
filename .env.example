# Configuración general del proyecto

# MongoDB Atlas URI (reemplaza con tu conexión real)
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/biogeovis?retryWrites=true&w=majority

# Nombre de la base de datos
MONGO_DB=biogeovis

# Secreto para JWT (genera uno seguro con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-change-in-production-123456789
